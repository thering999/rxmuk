          }
        ],
        "responses": {
          "200": {
            "description": "CSV UTF-8 คอลัมน์: hospcode, hospname, amp_code, rows, value, amount",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
