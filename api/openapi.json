{
  "openapi": "3.0.3",
  "info": {
    "title": "RxMuk Public API",
    "version": "1.1.0",
    "description": "สรุปข้อมูลการจ่ายยารายเดือน จังหวัดมุกดาหาร (HDC tmp_drug_opd)\n\n- เรียกได้ด้วย HTTP GET ธรรมดา ไม่ต้องมีบัญชี ไม่ต้องใช้ key\n- เป็นยอดรวมต่อตัวยา อำเภอ และหน่วยบริการเท่านั้น ไม่มีข้อมูลรายบุคคล\n- อัปเดตเมื่อผู้ดูแลกดเผยแพร่ในแท็บ API ของ RxMuk\n- value = มูลค่า (บาท), amount = จำนวนจ่าย (หน่วย), rows = จำนวนแถวข้อมูล"
  },
  "servers": [
    {
      "url": "https://vbxijqbgwgippdrhsjnb.supabase.co/storage/v1/object/public/rxmuk-public"
    }
  ],
  "paths": {
    "/index.json": {
      "get": {
        "summary": "รายการเดือนที่มีข้อมูล",
        "operationId": "listMonths",
        "responses": {
          "200": {
            "description": "รายการเดือนพร้อมยอดรวม",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Index"
                }
              }
            }
          }
        },
        "tags": [
          "เริ่มที่นี่"
        ]
      }
    },
    "/summary/{month}.json": {
      "get": {
        "summary": "สรุปของเดือนที่เลือก",
        "operationId": "getMonth",
        "parameters": [
          {
            "name": "month",
            "in": "path",
            "required": true,
            "description": "ปี-เดือน ค.ศ. รูปแบบ YYYY-MM (เช่น 2026-09 = กันยายน 2569) ดูเดือนที่มีได้จาก /index.json",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "example": "2026-09"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ยอดรวมต่อตัวยา อำเภอ และหน่วยบริการ",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MonthSummary"
                }
              }
            }
          },
          "400": {
            "description": "ไม่มีข้อมูลเดือนนี้ (Supabase ตอบ 400 Object not found)"
          }
        },
        "tags": [
          "รายเดือน"
        ]
      }
    },
    "/drugs/{month}.json": {
      "get": {
        "summary": "ยอดรวมต่อตัวยา (JSON)",
        "operationId": "drugsJson",
        "tags": [
          "รายเดือน"
        ],
        "parameters": [
          {
            "name": "month",
            "in": "path",
            "required": true,
            "description": "ปี-เดือน ค.ศ. รูปแบบ YYYY-MM (เช่น 2026-09 = กันยายน 2569) ดูเดือนที่มีได้จาก /index.json",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "example": "2026-09"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "array",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/Totals"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "didstd": {
                            "type": "string"
                          },
                          "dname": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "ไม่มีข้อมูลเดือนนี้"
          }
        }
      }
    },
    "/drugs/{month}.csv": {
      "get": {
        "summary": "ยอดรวมต่อตัวยา (CSV สำหรับ Excel / Google Sheets IMPORTDATA)",
        "operationId": "drugsCsv",
        "tags": [
          "รายเดือน"
        ],
        "parameters": [
          {
            "name": "month",
            "in": "path",
            "required": true,
            "description": "ปี-เดือน ค.ศ. รูปแบบ YYYY-MM (เช่น 2026-09 = กันยายน 2569) ดูเดือนที่มีได้จาก /index.json",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
              "example": "2026-09"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CSV UTF-8 คอลัมน์: didstd, dname, rows, value, amount",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "description": "ไม่มีข้อมูลเดือนนี้"
          }
        }
      }
    },
    "/districts/{month}.json": {
      "get": {
