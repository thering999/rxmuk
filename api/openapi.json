                      {
                        "type": "object",
                        "properties": {
                          "amp_code": {
                            "type": "string"
                          },
                          "amp_name": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "ไม่มีข้อมูลเดือนนี้"
