  "components": {
    "schemas": {
      "Totals": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "integer"
          },
          "amount": {
            "type": "number",
            "description": "จำนวนที่จ่าย (หน่วย)"
          },
          "value": {
            "type": "number",
            "description": "มูลค่า/ราคาขายรวม (บาท)"
          },
          "cost": {
            "type": "number",
            "description": "ต้นทุนรวม (บาท) (cost / unit_cost มีเมื่อ index.includes_cost = true)"
          }
        }
      },
      "Index": {
        "type": "object",
        "properties": {
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "months": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Totals"
                },
                {
                  "type": "object",
                  "properties": {
                    "month": {
                      "type": "string",
                      "example": "2026-09"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          },
          "schema_version": {
            "type": "string",
            "example": "1.3"
          },
          "terms": {
            "type": "string",
            "description": "เงื่อนไขการใช้ข้อมูล"
          },
          "includes_cost": {
            "type": "boolean"
          },
          "min_cell": {
            "type": "integer",
            "example": 5,
            "description": "ยาที่จ่ายน้อยกว่าค่านี้ต่อพื้นที่ถูกรวมเป็น \"อื่นๆ\""
          },
          "guide": {
            "type": "string"
          }
        }
      },
      "MonthSummary": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Totals"
          },
          {
            "type": "object",
            "properties": {
              "month": {
                "type": "string",
                "example": "2026-09"
              },
              "drugs": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/drugs"
                }
              },
              "districts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/districts"
                }
              },
              "hospitals": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/hospitals"
                }
              }
            }
          }
        ]
      },
      "drugs": {
        "type": "object",
        "properties": {
          "didstd": {
            "type": "string"
          },
          "dname": {
            "type": "string"
          },
          "rows": {
            "type": "integer"
          },
          "amount": {
            "type": "number",
            "description": "จำนวนที่จ่าย (หน่วย)"
          },
          "value": {
            "type": "number",
            "description": "มูลค่า/ราคาขายรวม (บาท)"
          },
          "cost": {
            "type": "number",
            "description": "ต้นทุนรวม (บาท)"
          },
          "unit_price": {
            "type": "number",
            "nullable": true,
            "description": "value / amount"
          },
          "unit_cost": {
            "type": "number",
            "nullable": true,
            "description": "cost / amount"
          }
        }
      },
      "districts": {
        "type": "object",
        "properties": {
          "amp_code": {
            "type": "string"
          },
          "amp_name": {
            "type": "string"
          },
          "rows": {
            "type": "integer"
          },
          "amount": {
            "type": "number",
            "description": "จำนวนที่จ่าย (หน่วย)"
          },
