                          "amp_code": {
                            "type": "string"
                          }
                        }
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "ไม่มีข้อมูลเดือนนี้"
          }
        }
      }
    },
    "/hospitals/{month}.csv": {
      "get": {
        "summary": "ยอดรวมต่อหน่วยบริการ (CSV สำหรับ Excel / Google Sheets IMPORTDATA)",
        "operationId": "hospitalsCsv",
        "tags": [
          "รายเดือน"
        ],
        "parameters": [
          {
            "name": "month",
            "in": "path",
            "required": true,
            "description": "ปี-เดือน ค.ศ. รูปแบบ YYYY-MM (เช่น 2026-09 = กันยายน 2569) ดูเดือนที่มีได้จาก /index.json",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
