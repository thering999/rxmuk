    "/districts/{month}.csv": {
      "get": {
        "summary": "ยอดรวมต่ออำเภอ (CSV สำหรับ Excel / Google Sheets IMPORTDATA)",
        "operationId": "districtsCsv",
        "tags": [
          "รายเดือน"
        ],
        "parameters": [
          {
            "name": "month",
            "in": "path",
            "required": true,
            "description": "ปี-เดือน ค.ศ. รูปแบบ YYYY-MM (เช่น 2026-09 = กันยายน 2569) ดูเดือนที่มีได้จาก /index.json",
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}$",
