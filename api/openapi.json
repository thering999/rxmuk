          }
        }
      }
    },
    "/trend/drugs.json": {
      "get": {
        "summary": "แนวโน้มมูลค่า/จำนวนรายตัวยาทุกเดือน (JSON)",
        "operationId": "trendJson",
        "tags": [
          "แนวโน้ม"
        ],
        "responses": {
          "200": {
            "description": "value[i] / amount[i] ตรงกับ months[i]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "months": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "drugs": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "didstd": {
                            "type": "string"
                          },
                          "dname": {
                            "type": "string"
                          },
                          "value": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          },
                          "amount": {
                            "type": "array",
                            "items": {
                              "type": "number"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/trend/drugs.csv": {
      "get": {
        "summary": "แนวโน้มมูลค่ารายตัวยา (CSV คอลัมน์ละเดือน)",
        "operationId": "trendCsv",
        "tags": [
          "แนวโน้ม"
        ],
        "responses": {
          "200": {
            "description": "didstd, dname, value_YYYY-MM ...",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Totals": {
        "type": "object",
        "properties": {
          "rows": {
            "type": "integer"
          },
          "value": {
            "type": "number",
            "description": "บาท"
          },
          "amount": {
            "type": "number",
            "description": "หน่วย"
          }
        }
      },
      "Index": {
        "type": "object",
        "properties": {
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string"
          },
          "months": {
            "type": "array",
            "items": {
              "allOf": [
                {
                  "$ref": "#/components/schemas/Totals"
                },
                {
                  "type": "object",
                  "properties": {
                    "month": {
                      "type": "string",
                      "example": "2026-09"
                    },
                    "url": {
                      "type": "string"
                    }
                  }
                }
              ]
            }
          }
        }
      },
      "MonthSummary": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Totals"
          },
          {
            "type": "object",
            "properties": {
              "month": {
                "type": "string",
                "example": "2026-09"
              },
              "drugs": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Totals"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "didstd": {
                          "type": "string"
                        },
                        "dname": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              },
              "districts": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Totals"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "amp_code": {
                          "type": "string"
                        },
                        "amp_name": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              },
              "hospitals": {
                "type": "array",
                "items": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Totals"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "hospcode": {
                          "type": "string"
                        },
                        "hospname": {
                          "type": "string"
                        },
                        "amp_code": {
                          "type": "string"
                        }
                      }
                    }
                  ]
                }
              }
            }
          }
        ]
      }
    }
